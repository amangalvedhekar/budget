{
  "name": "infra",
  "root": "apps/infra",
  "targets": {
    "synth": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk synth",
        "cwd": "apps/infra"
      }
    },
    "diff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk diff",
        "cwd": "apps/infra"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk deploy",
        "cwd": "apps/infra"
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk destroy",
        "cwd": "apps/infra"
      }
    }
  }
}
